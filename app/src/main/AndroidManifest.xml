<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      РАЗРЕШЕНИЙ НЕТ. НАМЕРЕННО.

      В частности, здесь нет android.permission.INTERNET.
      Это не обещание в политике конфиденциальности, а проверяемый факт:
      приложение технически не способно отправить наружу ни один байт.
      Для клавиатуры, которая по определению видит пароли и переписку,
      это единственная допустимая позиция.

      Если в этом файле однажды появится INTERNET — это баг или атака.
      Проверить в собранном APK:  aapt dump permissions app-release.apk
    -->

    <!--
      androidx.core безусловно добавляет в свой манифест самоадресованное
      разрешение DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION — служебное,
      для ContextCompat.registerReceiver на API меньше 33, которым этот
      проект не пользуется. Список разрешений в APK обязан быть пустым,
      поэтому узел явно вырезается при слиянии манифестов.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Souchastnik">

        <!-- FastRPC на Snapdragon: libcdsprpc.so в /vendor/lib64, в APK не кладём.
             Без uses-native-library линкер приложения её не видит (namespace). -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <uses-native-library
            android:name="libadsprpc.so"
            android:required="false" />

        <service
            android:name=".ime.SouchastnikIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
          Движок живёт в ОТДЕЛЬНОМ процессе.
          Клавиатура не имеет права умирать: если IME убьют по OOM,
          пользователь останется без ввода во всей системе.
          Модель на ~700 МБ RSS сидит здесь; убили этот процесс —
          строка просто погасла, клавиатура продолжает работать.
        -->
        <service
            android:name=".engine.EngineService"
            android:exported="false"
            android:process=":engine" />

        <activity
            android:name=".ime.SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          BenchActivity объявлена в app/src/debug/AndroidManifest.xml и в
          релизный APK не попадает. Она exported (иначе `am start` из adb её
          не поднимет), а exported-активити может дёрнуть любое установленное
          приложение — в релизе это лишняя дверь к загрузке модели.
        -->

    </application>
</manifest>
